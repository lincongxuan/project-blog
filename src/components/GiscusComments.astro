---
const repo = import.meta.env.PUBLIC_GISCUS_REPO;
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY;
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
const enabled = Boolean(repo && repoId && category && categoryId);
---

<section class="comments" aria-label="评论">
  <div class="section-heading compact-heading">
    <p class="eyebrow">讨论</p>
    <h2>留下你的想法</h2>
  </div>
  {enabled ? (
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="preferred_color_scheme"
      data-lang="zh-CN"
      crossorigin="anonymous"
      async
    ></script>
  ) : (
    <p class="muted comment-placeholder">评论功能尚未配置。启用 Giscus 后，这里会显示基于 GitHub Discussions 的评论区。</p>
  )}
</section>
