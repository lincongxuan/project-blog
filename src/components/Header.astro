---
import { navigation } from '@/data/navigation';
import { site } from '@/data/site';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const returnAction =
  /^\/projects\/[^/]+(?:\/[^/]+)?\/?$/.test(currentPath) || /^\/blog\/[^/]+\/?$/.test(currentPath)
    ? { href: '/projects', label: '返回项目' }
    : /^\/projects\/?$/.test(currentPath)
      ? { href: '/', label: '返回主页' }
      : undefined;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.name} 首页`}>
      <span class="brand-mark">{site.shortName}</span>
      <span>{site.name}</span>
    </a>

    <div class="header-actions">
      <nav id="main-nav" class="main-nav" aria-label="主导航">
        {navigation.map((item) => (
          <a href={item.href} class:list={{ active: currentPath.startsWith(item.href) }}>
            {item.label}
          </a>
        ))}
        <a href="/search" class="nav-search">
          搜索 <span aria-hidden="true">⌕</span>
        </a>
        <ThemeToggle />
      </nav>

      {returnAction && (
        <a class="header-return-link" href={returnAction.href}>
          <span aria-hidden="true">←</span>
          <span>{returnAction.label}</span>
        </a>
      )}

      <button
        class="menu-toggle"
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="main-nav"
      >
        <span class="sr-only">打开菜单</span>
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  const menuButton = document.querySelector('#menu-toggle');
  const nav = document.querySelector('#main-nav');
  menuButton?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open') ?? false;
    menuButton.setAttribute('aria-expanded', String(isOpen));
  });
</script>
