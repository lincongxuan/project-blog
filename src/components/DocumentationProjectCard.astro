---
import type { ProjectDocumentation } from '@/data/project-docs';

interface Props {
  project: ProjectDocumentation;
}

const { project } = Astro.props;
---

<article
  class="card project-card documentation-project-card"
  data-project-card
  data-status={project.status}
>
  <div class="card-body documentation-project-body">
    <div class="project-meta">
      <span class="status">{project.statusLabel}</span>
    </div>
    <p class="eyebrow project-kind">{project.kind}</p>
    <h3>
      <a href={project.route}>{project.name}</a>
    </h3>
    <p>{project.cardDescription}</p>
    <div class="tag-row">
      {project.tags.map((tag) => (
        <span>#{tag}</span>
      ))}
    </div>
    <div class="card-actions">
      <a class="text-link" href={project.route}>
        进入项目 <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>
